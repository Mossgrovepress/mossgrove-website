<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,700;0,900&display=swap" rel="stylesheet">
<style>
  :root{--ink:#33393f;--paper:#fbf9f4;--slate:#5b7285;--terracotta:#c1694f;--sage:#8a9b6e;--muted:#6f6a5f;--border:#e3ded2;}
  *{box-sizing:border-box;}
  body{margin:0;font-family:'Poppins',system-ui,sans-serif;background:var(--paper);color:var(--ink);font-size:17px;line-height:1.6;}
  h1,.btn{font-weight:900;}
  a{color:inherit;}
  .card{max-width:480px;margin:9vh auto 0;padding:0 24px;text-align:center;}
  .card img{width:min(300px,75vw);height:auto;border-radius:10px;box-shadow:0 14px 34px rgba(51,57,63,0.18);margin-bottom:18px;}
  h1{font-size:26px;margin:0 0 10px;}
  p{color:var(--muted);margin:0 0 22px;}
  .btn{display:inline-block;padding:14px 28px;border-radius:999px;text-decoration:none;font-size:16px;border:2px solid var(--ink);background:var(--ink);color:var(--paper);}
  .btn:hover{background:var(--slate);border-color:var(--slate);}
  .small{font-size:13px;color:var(--muted);margin-top:18px;}

  /* Amazon store flags (added 2026-09-27) */
  .amz-label{margin:0 0 8px;font-weight:700;}
  .amz-flags{display:flex;flex-wrap:wrap;gap:10px;}
  .amz-flags a{position:relative;display:inline-flex;border-radius:4px;box-shadow:0 0 0 1px var(--border),0 2px 6px rgba(0,0,0,.14);transition:transform .15s;}
  .amz-flags a::after{content:attr(data-label);position:absolute;left:50%;bottom:calc(100% + 7px);transform:translateX(-50%);background:#2b2b2b;color:#fff;font-size:12px;font-weight:600;line-height:1;padding:5px 8px;border-radius:5px;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .12s;z-index:5;}
  .amz-flags a:hover::after,.amz-flags a:focus-visible::after{opacity:1;}
  .amz-aff{margin:6px 0 0;font-size:13px;font-style:italic;color:var(--muted);}
  .amz-flags a:hover,.amz-flags a:focus-visible{transform:translateY(-2px);}
  .amz .amz-flags img{display:block;width:44px;height:33px;margin:0;border-radius:4px;box-shadow:none;}
  .amz-note{margin:10px 0 0;font-size:14px;color:var(--muted);}
  .amz img.amz-inline{display:inline;width:20px;height:15px;margin:0;vertical-align:-2px;border-radius:2px;box-shadow:0 0 0 1px var(--border);}
  .card .amz-flags{justify-content:center;}
  .amz-disc{font-size:13px;color:var(--muted);}
  @media (max-width:480px){.card .amz-flags{gap:6px;} .card .amz .amz-flags img{width:36px;height:27px;}}
</style>
</head>
